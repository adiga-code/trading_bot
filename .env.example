# ── Telegram ──────────────────────────────────────────────────────────────────
# Токен бота от @BotFather. СТАРЫЙ ТОКЕН СКОМПРОМЕТИРОВАН — перевыпусти через /revoke!
BOT_TOKEN=

# Telegram ID админов через запятую в JSON-формате, напр. [5992339874]
ADMIN_IDS=[]

# ID VIP-канала (бот должен быть админом с правом приглашать/банить), напр. -1001234567890.
# После оплаты бот сам шлёт одноразовый инвайт и удаляет из канала по истечении подписки.
# Если пусто — автовыдача отключена, доступ выдаётся вручную.
VIP_CHANNEL_ID=

# Публичный HTTPS-адрес приложения (Railway domain или свой домен), используется как Mini App URL
MINI_APP_URL=

# ── Домен (для деплоя на своём VPS через docker-compose) ───────────────────────
# Домен, на который уже настроена A-запись на IP этого сервера, напр. bot.example.com
DOMAIN=
# Email для выпуска SSL-сертификата Let's Encrypt (уведомления об истечении)
LETSENCRYPT_EMAIL=

# ── Платёжный шлюз ────────────────────────────────────────────────────────────
# 2328.io — API-ключ и ID проекта из кабинета
GATE2328_API_KEY=
GATE2328_PROJECT_ID=

# Куда 2328.io шлёт webhook об оплате (опционально; поллинг работает и без него)
PAYMENT_CALLBACK_URL=

# ── Прочее ────────────────────────────────────────────────────────────────────
# SQLite по умолчанию; для Postgres: postgresql+asyncpg://user:pass@host/db
DATABASE_URL=sqlite+aiosqlite:////data/bot.db

SUPPORT_USERNAME=forextrdk
PORT=8080
